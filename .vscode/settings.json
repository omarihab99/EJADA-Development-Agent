{
  // No VS Code setting exists to force a default custom agent for new chats.
  // Reliable enforcement is manual selection of "Universal Orchestrator" in the
  // agent picker, backed by the entry policy in .github/copilot-instructions.md and
  // the integrity tests in tests/.
  "chat.useAgentSkills": true,
  "chat.agentFilesLocations": {
    ".github/agents": true
  }
}
